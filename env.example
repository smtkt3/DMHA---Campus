# ==============================================================================
# DMHA — Smart Learning App · Production Environment Variables Template
# Copy this file to `.env.local` (never commit real secrets to Git!)
# ==============================================================================

# 1. Public Domain (Required for HTTPS WebAuthn Face ID / Fingerprint & Payment Callbacks)
NEXT_PUBLIC_SITE_URL=https://portal.dmha.edu.bd

# 2. Cloud PostgreSQL Database (Optional upgrade from built-in SQLite WAL)
# Supports Supabase, Neon, Railway, or self-hosted PostgreSQL
DATABASE_URL=

# 3. Payment Gateway — SSLCommerz (Bangladesh: bKash, Nagad, Rocket, Visa, Mastercard)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_LIVE=false

# 4. Payment Gateway — Stripe (Optional International Cards) & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DMHS_WEBHOOK_SECRET=

# 5. Production Security Guard (Automatically disables 1-Click Demo Login in production)
DMHS_ALLOW_DEMO_LOGIN=false

# 5. WhatsApp & SMS Alerts — Twilio (Global WhatsApp + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# 6. Local SMS Gateway — BulkSMS BD (Bangladesh Local SMS)
BULKSMS_BD_API_KEY=
BULKSMS_BD_SENDER_ID=

# 7. Cloud File Storage — Cloudflare R2 / AWS S3 (Exam Sheets & Student Documents)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
